# Copy to .env. Keep credentials outside Git.
# Use a file containing DBRICKS_URL=... and DBRICKS_TOKEN=...
LOCAL_AGENT_ENV_FILE=/absolute/path/to/env_vars.txt
LOCAL_AGENT_WORKSPACE=/absolute/path/to/project
# Databricks serving endpoint. Without this line the app uses databricks-claude-opus-5-5.
# Once a model is saved in Settings or the model picker, the saved one wins.
LOCAL_AGENT_MODEL=databricks-claude-opus-5-5
LOCAL_AGENT_STATE_DIR=/absolute/path/to/local-agent-state
# Optional: absolute folder where the agent creates new standalone code when you do not say where,
# for example /absolute/path/to/code. Every chat may use it without a Folder access card;
# edits still follow the permission mode. Leave empty to turn it off.
LOCAL_AGENT_CODING_DIR=
# Optional: Python virtual environment (the folder that contains bin/python and pyvenv.cfg) that the
# agent's commands, Verify, hooks and the Terminal use (stdio MCP servers do not), for example
# /absolute/path/to/project/.venv. Leave empty to turn it off.
LOCAL_AGENT_PYTHON_VENV=
# Default port is 8765.
